<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartGreen.View.RecoveryPass.RecoveryCode"  Shell.NavBarIsVisible="False" Shell.FlyoutBehavior="Disabled"
             Title="RecoveryCode"  BackgroundImageSource="hum.jpg" Opacity=".9">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto, Auto, Auto, *">
            <!-- Fondo blanco redondeado -->
            <Grid Grid.Row="0">
                <RoundRectangle Margin="15,120,15,-620"
                         CornerRadius="30,30,30,30"
                         Fill="White"
                         Opacity=".7"/>
            </Grid>

            <Grid Grid.Row="1">
                <Image Source="logooff.png" Scale=".8" Margin="0,90,0,100"/>
                <Label FontAttributes="Bold" FontFamily="bold"
                FontSize="28"
                Text="Recuperar contraseña" VerticalOptions="Center"
                HorizontalOptions="Center"
                TextColor="#508029" Margin="0,210,0,0"/>
                <Label Text="Introduce el código envíado al correo que proporcionaste para continuar:" FontFamily="bold" 
                    FontSize="17" Margin="30,355,30,60"
                    HorizontalOptions="Center" TextColor="#777965"/>
            </Grid>

            <!-- Campos de entrada -->
            <Grid Grid.Row="2" Margin="110,-40,110,0" VerticalOptions="Center"> 
                <Entry Text="{Binding Code}" Placeholder="   0-0-0-0-0-0   "  HeightRequest="45" 
                       FontSize="22" TextColor="Black" Keyboard="Numeric" PlaceholderColor="Gray"
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center" 
                       />
            </Grid>

            <!-- Botones -->
            <Grid Grid.Row="4" Margin="110,0,110,40">
                <Button Text="Válidar código" BackgroundColor="#508029" TextColor="White" HeightRequest="42"
                     Command="{Binding SendCodeCommand}"
                 CornerRadius="25" HorizontalOptions="FillAndExpand" FontSize="Medium" FontAttributes="Bold"/>
                <Label Text="{Binding MsgCode}" TextColor="red" FontSize="Small" Margin="0,-3,0,0"  HorizontalTextAlignment="Center" />
            </Grid>

            <Grid Grid.Row="5" Margin="110,90,110,0">
                <Button Text="Cancelar" BackgroundColor="#b2b0a8" TextColor="White" HeightRequest="42"
                     Command="{Binding ToBack}"
                 CornerRadius="25" HorizontalOptions="FillAndExpand" FontSize="Medium" FontAttributes="Bold" />
            </Grid>
        </Grid>
    </VerticalStackLayout>
</ContentPage>